# Appwrite Cloud Configuration — https://cloud.appwrite.io
# WARNING: Anything prefixed EXPO_PUBLIC_ is bundled into client JS.
# Never place secret API keys here. Use document permissions for access control.

EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your_project_id_here
EXPO_PUBLIC_APPWRITE_PLATFORM=dev.yourname.booktracker
EXPO_PUBLIC_APPWRITE_DATABASE_ID=your_database_id_here
EXPO_PUBLIC_APPWRITE_BOOKS_COLLECTION_ID=your_books_collection_id_here
